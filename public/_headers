# The HTML must never be cached: it names the hashed bundle, and a stale
# copy serves yesterday's app. The hashed assets themselves are immutable.
# Honored natively by Cloudflare Workers Static Assets and Netlify; an inert
# extra file everywhere else (configure the equivalents in the host).
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Fonts are not content-hashed (the emoji subset gets regenerated), so a
# day, not a year
/fonts/*
  Cache-Control: public, max-age=86400
# Seed files are fetched with a ?v=<content hash> baked into the bundle
# (vite.config.js seedVersion), so each version's URL is unique and the
# response can be cached forever; a deploy that changes a seed changes
# its URL, not this rule
/seed/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
