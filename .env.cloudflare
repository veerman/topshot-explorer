# Loaded by `npm run build:cloudflare` (vite build --mode cloudflare).
# Routes the app's Flow reads through the same-origin caching proxy in
# deploy/cloudflare/worker.js. The plain `npm run build` ignores this file
# and talks to rest-mainnet.onflow.org directly.
VITE_FLOW_ACCESS_NODE=/flow
# Derived media (512px thumbnails, set art, logos) served from the R2
# bucket (MEDIA-PIPELINE.md). Unset in the portable build: the app falls
# back to gateway originals and in-browser generation.
VITE_MEDIA_BASE=https://cache.topshotexplorer.com
