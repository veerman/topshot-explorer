{
  "name": "topshot-explorer-v2",
  "private": true,
  "version": "2.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "reconcile": "node --import ./scripts/node-json-hook.mjs scripts/reconcile-tags.mjs",
    "reconcile:check": "node --import ./scripts/node-json-hook.mjs scripts/reconcile-tags.mjs --dry-run",
    "atlas:harvest": "node scripts/atlas-harvest.mjs",
    "atlas:parallels": "node --import ./scripts/node-json-hook.mjs scripts/atlas-parallels.mjs",
    "atlas:tags": "node --import ./scripts/node-json-hook.mjs scripts/atlas-tags.mjs",
    "atlas:editions": "node --import ./scripts/node-json-hook.mjs scripts/atlas-editions.mjs",
    "atlas:burns": "node --import ./scripts/node-json-hook.mjs scripts/atlas-burns.mjs",
    "atlas:autographs": "node --import ./scripts/node-json-hook.mjs scripts/atlas-autographs.mjs",
    "atlas:refresh": "npm run atlas:harvest && npm run atlas:burns && npm run atlas:autographs && npm run atlas:parallels && npm run atlas:editions && npm run atlas:tags",
    "prebuild": "node --import ./scripts/node-json-hook.mjs scripts/reconcile-tags.mjs --allow-offline",
    "build": "vite build",
    "wall:fold": "node scripts/wall-fold.mjs",
    "wall:reset": "node scripts/wall-reset.mjs",
    "build:cloudflare": "npm run build -- --mode cloudflare",
    "seed": "node --import ./scripts/node-json-hook.mjs scripts/build-seed.mjs",
    "offers": "node --import ./scripts/node-json-hook.mjs scripts/scan-offers.mjs",
    "awards": "node scripts/fetch-awards.mjs",
    "ipfs:probe": "node --import ./scripts/node-json-hook.mjs scripts/probe-missing.mjs",
    "media": "node scripts/media-derive.mjs",
    "media:sync": "node scripts/media-sync.mjs",
    "emoji:subset": "python -m fontTools.subset src/dev/fonts/Noto-COLRv1.ttf --text-file=src/dev/subset-text.txt --flavor=woff2 --layout-features=* --output-file=public/fonts/emoji-subset.woff2 && python -m fontTools.subset src/dev/fonts/TwemojiMozilla.ttf --text-file=src/dev/subset-text.txt --flavor=woff2 --layout-features=* --output-file=public/fonts/emoji-subset-colr0.woff2",
    "deploy:cloudflare": "npm run seed -- --if-stale && npm run offers && npm run build:cloudflare && wrangler deploy -c deploy/cloudflare/wrangler.jsonc",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@onflow/fcl": "^1.21.10",
    "@onflow/types": "^1.5.0",
    "mediacube": "file:packages/mediacube",
    "preact": "^10.29.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "ipfs-only-hash": "^4.0.0",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "vite": "^8.0.12",
    "wrangler": "^4.128.0"
  }
}
